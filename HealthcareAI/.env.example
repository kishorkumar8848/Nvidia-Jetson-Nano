# General Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Database Settings
SQLITE_DB_PATH=database/assistant.db

# LLM & Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=phi3:mini

# RAG Configuration
PROTOCOLS_DIR=data/protocols
VECTOR_STORE_DIR=vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ASR (Speech-to-Text) Configuration
ASR_MODEL_PROVIDER=bhashini  # or indicconformer
# If IndicConformer local model is used:
INDIC_CONFORMER_MODEL_PATH=models/indicconformer

# Translation Configuration
# Path to IndicTrans2 local model checkpoint files:
INDICTRANS2_MODEL_DIR=models/indictrans2

# Vision (Image Analysis) Configuration
VISION_MODEL_PROVIDER=moondream # or smolvlm
VISION_MODEL_PATH=models/moondream

# TTS (Text-to-Speech) Configuration
TTS_MODEL_PROVIDER=offline # or bhashini
TTS_AUDIO_OUTPUT_DIR=logs
